<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="520.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="glennon.gui.MainWindow">
    <children>
        <Label text="Glennon" styleClass="title"
               AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0" />
        <Label text="MISSION CONTROL / YOUR DAILY LOG" styleClass="subtitle"
               AnchorPane.topAnchor="54.0" AnchorPane.leftAnchor="20.0" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.topAnchor="84.0" AnchorPane.bottomAnchor="90.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="42.0"
                   promptText="What's the mission?" accessibleText="Mission command"
                   AnchorPane.bottomAnchor="38.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="100.0" />
        <Button fx:id="sendButton" onAction="#handleUserInput" text="Send" mnemonicParsing="false"
                prefHeight="42.0" prefWidth="76.0"
                AnchorPane.bottomAnchor="38.0" AnchorPane.rightAnchor="16.0" />
        <Label text="todo · deadline · event · list · find · on · mark · unmark · delete · bye"
               styleClass="command-hint" wrapText="true"
               AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" />
    </children>
</AnchorPane>
